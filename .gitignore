# Dependencies
node_modules/

# Production build output
dist/
dist-ssr/

# Environment variables (Never push secrets!)
.env
.env.local

# Mac system files
.DS_Store

# Editor/AI config
.claude/

# Ignore the live database and auth secrets
data/*.json
# ...plus the database's temporary save file, any damaged copies set aside by server.ts,
# and the copies kept whenever a backup is restored
data/*.json.tmp
data/*.json.corrupt-*
data/*.json.before-restore-*

# Each source's saved channels (one file per source), and the copy of db.json kept from
# before it was split into several files
data/pool/
data/*.json.before-split-*

# Downloaded TV guides (programmes are kept on disk)
data/epg/
